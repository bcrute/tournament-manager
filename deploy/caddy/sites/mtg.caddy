# mtg.skadoosh.dev's vhost, shipped by the deploy workflow to
# /opt/caddy/sites/mtg.caddy (validated against the merged config, then a
# graceful reload). This is the only Caddy config this repo ships: the root
# Caddyfile and the other sites/*.caddy files belong to the VPS and the other
# apps on it — social lives behind the same Caddy, and its config is never
# touched from here.
#
# Deliberately thin: the application owns every security header in
# backend/app/main.py, where they are reviewable and covered by
# frontend/e2e/privacy.spec.ts. Caddy used to set Referrer-Policy and
# Permissions-Policy here too, which silently overrode the app — it forced
# camera=() (breaking the in-app QR scanner, which needs camera=(self)) and
# downgraded the app's no-referrer. Setting them in one place only is the fix.

mtg.skadoosh.dev {
	encode gzip

	# The app owns its security headers; Caddy only strips its own Server banner.
	header -Server

	# Entrant tokens are query parameters (contract §1), so the access log must
	# never keep one: the filter encoder rewrites the value out of the logged
	# URI before the line is written, leaving the path and the parameter name.
	# Scoped to this vhost — the other apps behind this Caddy keep whatever
	# logging their own sites/*.caddy asks for.
	#
	# This is only half the job. The app writes its own access log (uvicorn,
	# on by default) and Caddy cannot touch it, so it redacts the same
	# parameter itself in backend/app/access_log.py. Both layers are required.
	#
	# Room identifiers need none of this, deliberately. Since 2026-07-31 a
	# room's credential is its 128-bit url_id, and it never appears in a URL:
	# the anonymous routes take it in a POST body, and invitation links carry
	# it in a fragment, which a browser does not transmit. A credential that is
	# never in a request line cannot be logged out of one — that is the point
	# of the shape, and why entrant tokens (which are still query parameters)
	# remain the awkward case.
	log {
		format filter {
			wrap console
			fields {
				request>uri query {
					replace token REDACTED
				}
			}
		}
	}

	reverse_proxy mtg:8000
}
