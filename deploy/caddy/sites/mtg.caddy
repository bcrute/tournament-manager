# mtg.skadoosh.dev's vhost, shipped by the deploy workflow to
# /opt/caddy/sites/mtg.caddy (validated against the merged config, then a
# graceful reload). This is the only Caddy config this repo ships: the root
# Caddyfile and the other sites/*.caddy files belong to the VPS and the other
# apps on it — social lives behind the same Caddy, and its config is never
# touched from here.
#
# Deliberately thin: the application owns every security header in
# backend/app/main.py, where they are reviewable and covered by
# frontend/e2e/privacy.spec.ts. Caddy used to set Referrer-Policy and
# Permissions-Policy here too, which silently overrode the app — it forced
# camera=() (breaking the in-app QR scanner, which needs camera=(self)) and
# downgraded the app's no-referrer. Setting them in one place only is the fix.

mtg.skadoosh.dev {
	encode gzip

	# The app owns its security headers; Caddy only strips its own Server banner.
	header -Server

	reverse_proxy mtg:8000
}
